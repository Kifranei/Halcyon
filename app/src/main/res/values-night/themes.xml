<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Match the system's dark launch surface before Compose has restored the saved theme. -->
    <style name="Theme.Ella" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="Theme.Ella.Casting" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#FFD0BCFF</item>
        <item name="colorPrimaryDark">#FFD0BCFF</item>
        <item name="colorAccent">#FFD0BCFF</item>
        <item name="mediaRouteTheme">@style/Theme.Ella.MediaRouterDialog</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- AndroidX MediaRouter requires opaque AppCompat color attributes. -->
    <style name="Theme.Ella.MediaRouterBridge" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#FFD0BCFF</item>
        <item name="colorPrimaryDark">#FFD0BCFF</item>
        <item name="colorAccent">#FFD0BCFF</item>
        <item name="android:colorBackground">#FF121212</item>
    </style>

    <style name="Theme.Ella.MediaRouterDialog" parent="Theme.MediaRouter">
        <item name="colorPrimary">#FFD0BCFF</item>
        <item name="colorAccent">#FFD0BCFF</item>
        <item name="android:colorBackground">#FF121212</item>
    </style>
</resources>
