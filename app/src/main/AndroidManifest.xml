<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur,rikka.shizuku.api,rikka.shizuku.provider,rikka.shizuku.shared,rikka.shizuku.aidl" />

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="com.lonx.lyrico" />
        <package android:name="com.example.LyricBox" />
        <package android:name="com.xjcheng.musictageditor" />
        <package android:name="com.andrewkhandr.aspectpro" />
        <package android:name="ka.spek" />
        <package android:name="com.hearusy.spectrum" />
        <package android:name="net.mediaarea.mediainfo" />
        <package android:name="com.android.musicfx" />
        <package android:name="com.miui.misound" />
        <package android:name="com.miui.player" />
        <package android:name="com.miui.audioeffect" />
        <package android:name="com.xiaomi.misound" />
        <package android:name="com.android.settings" />
        <package android:name="com.coloros.audioeffect" />
        <package android:name="com.oppo.audioeffect" />
        <package android:name="com.vivo.audiofx" />
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
        <intent>
            <action android:name="com.lonx.lyrico.action.EDIT_TAG" />
            <data android:mimeType="audio/*" />
        </intent>
    </queries>

    <application
        android:name=".EllaApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locale_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ella">

        <meta-data android:name="lyricon_module" android:value="true" />
        <meta-data android:name="lyricon_module_author" android:value="Kifranei" />
        <meta-data android:name="lyricon_module_description" android:value="愿所有的心声都在旋律里靠岸。" />
        <meta-data android:name="lyricon_module_tags" android:resource="@array/lyricon_module_tags" />

        <!-- Opt into the optional OPlus historical-player stack integration. -->
        <meta-data
            android:name="io.github.andrealtb.lockscreenlyrics.OPLUS_MEDIA_HISTORY"
            android:value="true" />

        <!-- Shown by MIUI/HyperOS in the uninstall confirmation dialog. -->
        <meta-data android:name="app_description_title" android:resource="@string/miui_uninstall_title" />
        <meta-data android:name="app_description_content" android:resource="@string/miui_uninstall_content" />

        <!-- HyperOS provides this service through its optional application-handoff SDK. -->
        <service
            android:name="com.xiaomi.dist.handoff.sdk.HandoffClientService"
            android:exported="false">
            <meta-data
                android:name="com.xiaomi.dist.handoff.metadata.SECURITY_CONFIG"
                android:resource="@xml/handoff_signature" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Ella">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="halcyon" android:host="search" />
                <data android:scheme="halcyon" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.halcyon.action.SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LyricTimingEditorActivity"
            android:exported="false"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Ella" />

        <activity
            android:name=".SpectrumViewerActivity"
            android:exported="false"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Ella" />

        <activity
            android:name=".MusicVideoActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Ella" />

        <activity-alias
            android:name="com.ella.music.DefaultLauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity="com.ella.music.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.ella.music.AnimeLauncherAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime"
            android:label="@string/app_name"
            android:targetActivity="com.ella.music.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.ella.music.BlackHairLauncherAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_black_hair"
            android:label="@string/app_name"
            android:targetActivity="com.ella.music.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.ella.music.LoliLauncherAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_loli"
            android:label="@string/app_name"
            android:targetActivity="com.ella.music.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ExternalPlaybackActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Ella.ExternalPlayback">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" android:mimeType="audio/*" />
                <data android:scheme="file" android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="audio/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="audio/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".player.PlaybackCompactWidgetProvider"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_playback_compact_info" />
        </receiver>

        <receiver
            android:name=".player.PlaybackExpandedWidgetProvider"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_playback_expanded_info" />
        </receiver>

        <service
            android:name=".player.DesktopLyricService"
            android:exported="false" />

        <service
            android:name=".player.XiaomiSuperIslandLyricService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live rendering of lyrics for Xiaomi Super Island" />
        </service>

        <service
            android:name=".mcp.McpServerService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <service
            android:name=".web.WebMusicService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
